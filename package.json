{
  "name": "secure-education-lms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Secure REST API backend for an online education LMS",
  "scripts": {
    "predev": "tsx src/scripts/bootstrap-super-admin.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "prestart": "node dist/scripts/bootstrap-super-admin.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-super-admin": "tsx src/scripts/bootstrap-super-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^6.4.21",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.17.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
