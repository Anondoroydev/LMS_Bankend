{
  "info": {
    "_postman_id": "4eecff90-2718-44c1-9cd8-6bb370c0100a",
    "name": "Secure Education LMS API",
    "description": "All backend routes grouped by workflow. There is exactly one Login request; it saves a token used by protected routes. Resource IDs are captured automatically from create/register responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "description": "One login request for any account role. Set email/password, send Login, then protected routes use the saved token.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Use the email and password variables for a student, teacher, or super admin. Successful login saves token and userRole.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const result = pm.response.json();",
                  "  if (pm.environment.name) pm.environment.set('token', result.token);\npm.collectionVariables.set('token', result.token);",
                  "  if (pm.environment.name) pm.environment.set('userRole', result.user.role);\npm.collectionVariables.set('userRole', result.user.role);",
                  "  if (result.user.role === 'STUDENT') { if (pm.environment.name) pm.environment.set('studentId', result.user.id);\npm.collectionVariables.set('studentId', result.user.id); }",
                  "  if (result.user.role === 'TEACHER') { if (pm.environment.name) pm.environment.set('teacherId', result.user.id);\npm.collectionVariables.set('teacherId', result.user.id); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newStudentName}}\",\n  \"email\": \"{{newStudentEmail}}\",\n  \"password\": \"{{newStudentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Public registration always creates a student account.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const result = pm.response.json(); if (result.user?.id) {",
                  "    if (pm.environment.name) pm.environment.set('studentId', result.user.id);",
                  "    pm.collectionVariables.set('studentId', result.user.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Get the account associated with the current token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revoke this account’s current JWTs."
          }
        },
        {
          "name": "Request password reset OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "Requires SMTP. OTP is emailed and expires after 10 minutes.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reset password with OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"otp\": \"{{resetOtp}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/reset-password",
            "description": "Set newPassword to a 16+ character strong password. Reset revokes existing sessions.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Super Admin",
      "description": "Teacher creation and student batch access grants are restricted to SUPER_ADMIN.",
      "item": [
        {
          "name": "Create teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newTeacherName}}\",\n  \"email\": \"{{newTeacherEmail}}\",\n  \"password\": \"{{newTeacherPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/teachers",
            "description": "Password must be at least 16 characters and include lowercase, uppercase, number, and special character."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const result = pm.response.json(); if (result.teacher?.id) {",
                  "    if (pm.environment.name) pm.environment.set('teacherId', result.teacher.id);",
                  "    pm.collectionVariables.set('teacherId', result.teacher.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Grant student access to batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/batches/{{batchId}}/enrollments",
            "description": "Grant the selected student access to this batch."
          }
        },
        {
          "name": "Revoke student batch access",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/batches/{{batchId}}/enrollments/{{studentId}}",
            "description": "Remove the student’s batch access."
          }
        }
      ]
    },
