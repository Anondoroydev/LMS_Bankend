    {
      "name": "Progress",
      "description": "Student playback heartbeat and progress; teacher batch and individual watch reports.",
      "item": [
        {
          "name": "Record video heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentId\": \"{{contentId}}\",\n  \"watchDurationDelta\": 10,\n  \"lastPosition\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/progress/heartbeat",
            "description": "Send no more frequently than once every 8 seconds; duration delta is capped at 15 seconds."
          }
        },
        {
          "name": "My progress",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/progress/me",
            "description": "Student-only batch/course video completion summary."
          }
        },
        {
          "name": "Batch progress",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/progress/batches/{{batchId}}",
            "description": "Teacher-only progress report for an owned batch."
          }
        },
        {
          "name": "Student watch logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/progress/batches/{{batchId}}/students/{{studentId}}",
            "description": "Teacher-only progress and watch history for one enrolled student."
          }
        }
      ]
